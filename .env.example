APP_ENV=local

# PostgreSQL local (Docker Compose creates this database).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/collections

# Mock collections backend.
MOCK_API_URL=http://localhost:8001
MOCK_TOKEN_SECRET=replace-with-output-from-openssl-rand-hex-32
MOCK_TOKEN_ISSUER=financial-agent-local-idp
MOCK_TOKEN_AUDIENCE=collections-api
MOCK_TOKEN_TTL_SECONDS=300

# Tool gateway resilience.
TOOL_TIMEOUT_SECONDS=0.25
TOOL_RETRY_ATTEMPTS=3
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_BREAKER_RESET_SECONDS=30
# Static per deployment (openssl rand -hex 12). Empty: each process draws a random canary.
SYSTEM_PROMPT_CANARY=

# Retrieval evidence gates. RAG_MIN_DENSE_SCORE comes from `make calibrate-rag`, which only
# reads the dev split (evals/retrieval_dev.yaml); the test split is never used for tuning.
RAG_MIN_RRF_SCORE=0.35
RAG_MIN_DENSE_SCORE=0.505
# From make calibrate-rerank (dev split). The gate (dense|rerank) was also chosen on dev.
RAG_MIN_RERANK_SCORE=0.209
RAG_EVIDENCE_GATE=dense

# Langfuse Cloud.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com

# OpenAI.
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=gpt-5-nano

# Cohere (optional): only `make rerank-cache` uses it; the rest reads data/rerank_cache.json.
COHERE_API_KEY=
