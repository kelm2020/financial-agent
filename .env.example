APP_ENV=local

# PostgreSQL local (Docker Compose creates this database).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/collections

# Mock collections backend.
MOCK_API_URL=http://localhost:8001
MOCK_TOKEN_SECRET=replace-with-output-from-openssl-rand-hex-32
# Seals the audit trail of agreements and transfers (openssl rand -hex 32). If unset, production
# derives one from MOCK_TOKEN_SECRET; set it so audit keys rotate independently from auth.
AUDIT_HMAC_KEY=
MOCK_TOKEN_ISSUER=financial-agent-local-idp
MOCK_TOKEN_AUDIENCE=collections-api
MOCK_TOKEN_TTL_SECONDS=300

# Tool gateway resilience.
TOOL_TIMEOUT_SECONDS=0.25
TOOL_RETRY_ATTEMPTS=3
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_BREAKER_RESET_SECONDS=30
# Static per deployment (openssl rand -hex 12). In production, empty derives a stable fallback
# from MOCK_TOKEN_SECRET; set it explicitly so canary rotation is independent from auth rotation.
SYSTEM_PROMPT_CANARY=

# Retrieval evidence gates. RAG_MIN_DENSE_SCORE comes from `make calibrate-rag`, which only
# reads the dev split (evals/retrieval_dev.yaml); the test split is never used for tuning.
RAG_MIN_RRF_SCORE=0.35
RAG_MIN_DENSE_SCORE=0.505
# From make calibrate-rerank (dev split). The gate (dense|rerank) was also chosen on dev.
RAG_MIN_RERANK_SCORE=0.209
RAG_EVIDENCE_GATE=dense

# Langfuse Cloud.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com
# Self-hosted OTLP endpoint. Leave empty to disable tracing. With Compose running locally the
# default below points at the Langfuse container; ``tracing.py`` appends /api/public/otel/v1/traces
# and sends Basic auth built from LANGFUSE_PUBLIC_KEY + LANGFUSE_SECRET_KEY.
OTEL_EXPORTER_OTLP_ENDPOINT=

# OpenAI.
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=
# Semantic check of policy answers (ADR-011); defaults to gpt-5-mini.
OPENAI_CHECK_MODEL=
# Required only for `make score-judge` and `make eval-live JUDGE_MODEL=...`; must differ from
# OPENAI_AGENT_MODEL (self-preference bias).
OPENAI_JUDGE_MODEL=
# Required only for `make eval-sim`; must differ from OPENAI_AGENT_MODEL. Same provider still
# shares biases with the agent: treat simulation as a regression signal (§11.4).
OPENAI_SIMULATOR_MODEL=

# Cohere (optional): only `make rerank-cache` uses it; the rest reads data/rerank_cache.json.
COHERE_API_KEY=
