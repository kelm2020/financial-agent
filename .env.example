APP_ENV=local

# PostgreSQL local (Docker Compose creates this database).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/collections

# Mock collections backend.
MOCK_API_URL=http://localhost:8001
MOCK_TOKEN_SECRET=replace-with-output-from-openssl-rand-hex-32
MOCK_TOKEN_ISSUER=financial-agent-local-idp
MOCK_TOKEN_AUDIENCE=collections-api
MOCK_TOKEN_TTL_SECONDS=300

# Tool gateway resilience.
TOOL_TIMEOUT_SECONDS=0.25
TOOL_RETRY_ATTEMPTS=3
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_BREAKER_RESET_SECONDS=30

# Langfuse Cloud.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com

# OpenAI.
OPENAI_API_KEY=
